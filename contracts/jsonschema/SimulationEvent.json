{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moscow-hackathon.local/schemas/SimulationEvent.json",
  "title": "SimulationEvent",
  "description": "One row of the sim-v2 journal. The schema version (sim-event-v1) is stored once in the SimulationLog header.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "t_s",
    "type"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "t_s": {
      "type": "number",
      "minimum": 0,
      "description": "Simulated seconds from the horizon start, 0.1 s precision."
    },
    "type": {
      "type": "string",
      "enum": [
        "job_arrival",
        "dispatch",
        "route_start",
        "route_end",
        "resource_acquire",
        "resource_release",
        "load",
        "unload",
        "charge_start",
        "charge_end",
        "sla_reached",
        "sla_violated"
      ]
    },
    "job_id": {
      "type": "string"
    },
    "robot_id": {
      "type": "string"
    },
    "process_code": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "from_id": {
      "type": "string",
      "description": "Map point id."
    },
    "to_id": {
      "type": "string",
      "description": "Map point id."
    },
    "priority": {
      "type": "integer"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "route_start: point ids from from_id to to_id. The robot moves at constant speed for dur_s."
        },
        "dist_m": {
          "type": "number",
          "minimum": 0
        },
        "dur_s": {
          "type": "number",
          "minimum": 0
        },
        "loaded": {
          "type": "boolean"
        },
        "battery": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wait_s": {
          "type": "number",
          "minimum": 0
        },
        "cycle_s": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "description": "sla_violated: wait or cycle. Resource events: resource kind."
        },
        "queue": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
